# Copie para .dev.vars para testar localmente.
# O plugin do Cloudflare injeta estas variáveis no Worker (interface Env em worker/index.ts).
# Nunca versione o arquivo .dev.vars preenchido.

# Conta do treinador. Estas duas variáveis só têm efeito na PRIMEIRA vez que a
# aplicação sobe: a conta é semeada uma única vez. Depois disso, use
# `npm run coach:reset-password` para mudar e-mail ou senha.
COACH_EMAIL=
COACH_INITIAL_PASSWORD=

# Conta de manutenção (dashboard de diagnóstico), com acesso irrestrito.
# Deixe em branco para que ela simplesmente não exista.
DEV_LOGIN=
DEV_INITIAL_PASSWORD=

# Cifra os tokens de TODOS os provedores, não só os do Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Segredo que o Strava devolve ao validar o webhook. Escolha qualquer texto.
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_TOKEN_ENCRYPTION_KEY=

GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_ACTIVITY_API_ENABLED=false
GARMIN_TRAINING_API_ENABLED=false
# Endereço da Training API, entregue pelo Garmin ao aprovar a conta.
GARMIN_TRAINING_API_URL=

# O Zepp não tem API pública de leitura: as corridas chegam via Strava.
# Estas variáveis existem para o dia em que houver um caminho oficial.
ZEPP_APP_ID=
ZEPP_APP_SECRET=
ZEPP_WEBHOOK_SECRET=
