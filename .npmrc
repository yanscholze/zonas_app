# Não instalar versão publicada há menos de sete dias.
#
# É a janela em que um pacote comprometido costuma ser descoberto e despublicado.
# Sem isso, um `npm install` feito no dia do ataque traz a versão maliciosa; com
# isso, ele traz a anterior e o ataque passa longe. Sete dias é o padrão que o
# npm sugere — e o custo é só não estrear uma versão no dia em que sai.
minimum-release-age=10080

audit=false
fund=false
update-notifier=false
cache=.sites-runtime/npm-cache
